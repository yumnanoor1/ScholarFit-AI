# Copy to .env and fill in real values. Never commit .env. Values here are built into the site, so restart or rebuild after changing them.

# Backend API base URL. Replace with the deployed API URL outside local development.
VITE_API_BASE_URL=https://api.example.com

# The OAuth web client ID shown in Google Cloud Console. Not a secret; must equal GOOGLE_CLIENT_ID in backend/.env.
# Never put the client secret here: this file's values reach the browser, and this flow doesn't use it.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
