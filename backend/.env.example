# Copy to backend/.env and fill in real values. Never commit backend/.env.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fitscholar_db

# JWT signing key, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it logs out every user (existing tokens become invalid).
SECRET_KEY=

# development | test | production. Any other value stops the API.
# In production the API refuses to start unless SECRET_KEY, DATABASE_URL, FRONTEND_URL (https),
# SMTP_HOST + SMTP_FROM and GOOGLE_CLIENT_ID are all set. Always set this to production on a live server.
APP_ENV=development

# The OAuth web client ID that Google ID tokens must be issued for. Not a secret; set the same
# value as VITE_GOOGLE_CLIENT_ID in the frontend. This flow does not use the client secret.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The frontend address: reset links point here, and it is the only site CORS allows in production
FRONTEND_URL=http://localhost:5173

# Outgoing email for password reset links. Leave SMTP_HOST empty in development:
# the reset email is then printed to the backend console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FitScholars <no-reply@example.com>
SMTP_USE_TLS=true

# Behind a reverse proxy, start uvicorn with --proxy-headers --forwarded-allow-ips=<proxy address>
# so rate limits see each visitor's address. Run one worker: rate limit counts are per process.
